#!/usr/bin/env zsh

# ──────────────────────────────────────────────────────────────────────
# Sets up the defaults for git
#
# Requires: gum, git
# ──────────────────────────────────────────────────────────────────────

# ---Sanity checks
command -v gum >/dev/null 2>&1 || {
  print -u2 "❌ gum not found. Install with: brew install gum"
  return 1
}

command -v git >/dev/null 2>&1 || {
  print -u2 "❌ git not found. Install with: brew install git"
  return 1
}

# ──────────────────────────────────────────────────────────────────────

local GIT_USERNAME GIT_EMAIL
GIT_USERNAME=$(git config --global --get user.name || true)
GIT_EMAIL=$(git config --global --get user.email || true)

# User (only ask when not configured yet, never write an empty value)
if [[ -z $GIT_USERNAME ]]; then
    GIT_USERNAME=$(gum input --prompt "GitHub username: " || true)
    [[ -n $GIT_USERNAME ]] && git config --global user.name "$GIT_USERNAME"
fi

if [[ -z $GIT_EMAIL ]]; then
    GIT_EMAIL=$(gum input --prompt "GitHub email: " || true)
    [[ -n $GIT_EMAIL ]] && git config --global user.email "$GIT_EMAIL"
fi

[[ -z $(git config --global --get user.name || true) || -z $(git config --global --get user.email || true) ]] \
    && log_warning "Git user.name/user.email not set"

# Color
git config --global color.diff auto

# Push
git config --global push.default current

# Pull
git config --global pull.ff only

# Merge
git config --global merge.ff only
git config --global merge.conflictstyle diff3

# Checkout
git config --global checkout.defaultRemote origin

# Init
git config --global init.defaultBranch main

# Core
mkdir -p "$HOME/.config/git/hooks"
ln -nfs "$ROOT_DIR/git/.gitignore_global" "$HOME/.config/git/.gitignore_global"
git config --global core.excludesfile "$HOME/.config/git/.gitignore_global"

# Secret scan on every commit. A config-based hook runs alongside each repo's own
# hooks dir (Husky etc.); a global core.hooksPath would replace it.
ln -nfs "$ROOT_DIR/git/hooks/gitleaks" "$HOME/.config/git/hooks/gitleaks"
git config --global --replace-all hook.gitleaks.event pre-commit
git config --global hook.gitleaks.command "$HOME/.config/git/hooks/gitleaks"
