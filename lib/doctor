#!/usr/bin/env zsh

# ──────────────────────────────────────────────────────────────────────
# Dotfiles doctor
#
# Checks the health of your dotfiles installation and reports issues.
# Returns non-zero when any check fails (warnings do not affect the status).
# ──────────────────────────────────────────────────────────────────────

_dr_pass=0
_dr_warn=0
_dr_fail=0

# Never use `(( x++ ))` as a statement — it returns non-zero when x is 0 and
# `set -e` (inherited from the dotfiles CLI) would abort the whole run.
check_section() { echo; gum style --bold --foreground 244 "🔍 $1" }
check_pass()    { _dr_pass=$((_dr_pass + 1)); log_success "$1" }
check_warn()    { _dr_warn=$((_dr_warn + 1)); log_warning "$1" }
check_fail()    { _dr_fail=$((_dr_fail + 1)); log_error "$1" }

gum style --bold --foreground 212 "Checking dotfiles status..."

# --- Homebrew
check_section "Homebrew"
if ! command -v brew >/dev/null 2>&1; then
    check_fail "Homebrew not installed"
else
    outdated=$(brew outdated --quiet 2>/dev/null | wc -l | tr -d ' ' || true)
    [[ -z $outdated ]] && outdated=0
    if [[ $outdated -gt 0 ]]; then
        check_warn "$outdated outdated package(s) — run 'brew upgrade'"
    else
        check_pass "All packages up to date"
    fi

    if brew bundle check --file="$ROOT_DIR/Brewfile" --no-upgrade >/dev/null 2>&1; then
        check_pass "All Brewfile packages installed"
    else
        check_warn "Unmet Brewfile dependencies:"
        brew bundle check --file="$ROOT_DIR/Brewfile" --no-upgrade --verbose 2>&1 \
            | grep 'needs to be' | sed 's/^→ /     /' || true
    fi
fi

# --- Symlinks
check_section "Symlinks"
_sym_bad=0
for link in \
    "$HOME/.zlogin" \
    "$HOME/.zprofile" \
    "$HOME/.zshenv" \
    "$HOME/.zshrc" \
    "$HOME/.config/zsh/_init.sh" \
    "$HOME/.config/zsh/autoloaded" \
    "$HOME/.config/starship.toml" \
    "$HOME/.config/ghostty/config" \
    "$HOME/.config/bat/config" \
    "$HOME/.config/hammerspoon" \
    "$HOME/.vimrc" \
    "$HOME/.config/hblock/header" \
    "$HOME/.config/hblock/allow.list" \
    "$HOME/.config/hblock/deny.list" \
    "$HOME/.ssh/config" \
    "$HOME/bin/dotfiles"
do
    if [[ ! -L $link ]]; then
        check_fail "Not a symlink: ${link/#$HOME/~}"
        _sym_bad=$((_sym_bad + 1))
    elif [[ ! -e $link ]]; then
        check_fail "Broken symlink: ${link/#$HOME/~}"
        _sym_bad=$((_sym_bad + 1))
    fi
done

cfg_files=("$HOME"/.config/zsh/config.d/*.sh(N))
if [[ ${#cfg_files} -eq 0 ]]; then
    check_fail "No config.d/*.sh files linked"
    _sym_bad=$((_sym_bad + 1))
fi

[[ $_sym_bad -eq 0 ]] && check_pass "All expected symlinks present"

# --- Login shell
check_section "Login shell"
if command -v brew >/dev/null 2>&1; then
    brew_zsh="$(brew --prefix)/bin/zsh"
    login_shell=$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}' || true)
    if [[ ! -x $brew_zsh ]]; then
        check_warn "Homebrew zsh not found at $brew_zsh"
    elif [[ $login_shell != "$brew_zsh" ]]; then
        check_warn "Login shell is ${login_shell:-unknown}, not $brew_zsh — run 'dotfiles install' → Login shell"
    else
        check_pass "Login shell is Homebrew zsh"
    fi
fi

# --- Completion cache
check_section "Completion cache"
if [[ -s "$HOME/.config/zsh/.zcompdump" ]]; then
    check_pass "compdump present (~/.config/zsh/.zcompdump)"
else
    check_warn "No compdump yet — open a new shell to build it"
fi

# --- Hosts blocklist
check_section "Hosts blocklist"
if ! command -v hblock >/dev/null 2>&1; then
    check_warn "hblock not installed"
elif ! grep -q hblock /etc/hosts 2>/dev/null; then
    check_warn "/etc/hosts is not hblock-generated — run 'dotfiles install' → Hosts file"
else
    blocked=$(grep -c '^0\.0\.0\.0 ' /etc/hosts 2>/dev/null || echo 0)
    check_pass "hblock active (${blocked} domains blocked)"
fi

# --- Required tools
check_section "Required tools"
_tools_bad=0
for tool in gum git nodenv starship eza bat fd fzf gh gitleaks hblock; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        check_fail "$tool not installed"
        _tools_bad=$((_tools_bad + 1))
    fi
done
[[ $_tools_bad -eq 0 ]] && check_pass "All required tools installed"

# --- Git
check_section "Git"
if command -v git >/dev/null 2>&1; then
    git_email=$(git config --global user.email 2>/dev/null || true)
    if [[ -n $git_email ]]; then
        check_pass "git identity set ($git_email)"
    else
        check_warn "git user.email not set — run 'dotfiles install' → Git"
    fi

    hooks_path=$(git -C "$ROOT_DIR" config --get core.hooksPath 2>/dev/null || true)
    if [[ $hooks_path == "$ROOT_DIR/.githooks" || $hooks_path == ".githooks" ]]; then
        check_pass "pre-commit hook wired (gitleaks scan)"
    else
        check_warn "core.hooksPath not set for this repo — run 'dotfiles install' → Git"
    fi
fi

# --- nodenv
check_section "nodenv"
if ! command -v nodenv >/dev/null 2>&1; then
    check_fail "nodenv not installed"
else
    nodenv_global=$(nodenv global 2>/dev/null || true)
    if [[ -z $nodenv_global || $nodenv_global == system ]]; then
        check_warn "No nodenv global version set — run 'nodenv global <version>'"
    else
        check_pass "nodenv global: $nodenv_global"
    fi
fi

# --- Personal folders
check_section "Personal folders"
for d in "$HOME/Desktop/Temp" "$HOME/Desktop/Screenshots"; do
    if [[ -d $d ]]; then
        check_pass "${d/#$HOME/~} exists"
    else
        check_warn "${d/#$HOME/~} missing"
    fi
done

# --- macOS defaults
check_section "macOS defaults"
if defaults read com.apple.dock autohide 2>/dev/null | grep -q 1; then
    check_pass "Dock autohide enabled"
else
    check_warn "Dock autohide off — run 'dotfiles install' → macOS defaults"
fi

# --- Hammerspoon
check_section "Hammerspoon"
hs_cfg=$(defaults read org.hammerspoon.Hammerspoon MJConfigFile 2>/dev/null || true)
if [[ $hs_cfg == *".config/hammerspoon"* ]]; then
    check_pass "Config dir points at ~/.config/hammerspoon"
else
    check_warn "Hammerspoon MJConfigFile not set to ~/.config/hammerspoon — run 'dotfiles install' → macOS defaults"
fi
if ! pgrep -x Hammerspoon >/dev/null 2>&1; then
    check_warn "Hammerspoon is not running"
elif ! command -v hs >/dev/null 2>&1; then
    check_warn "Hammerspoon IPC CLI (hs) not found — enable hs.ipc in the console"
elif hs -c "hs.ipc" >/dev/null 2>&1; then
    check_pass "IPC responsive"
else
    check_fail "Hammerspoon IPC not responding"
fi

# --- Summary
echo ""
gum style --bold --foreground 212 "🩺 Doctor summary"
echo "   $_dr_pass ok · $_dr_warn warning(s) · $_dr_fail error(s)"

if [[ $_dr_fail -gt 0 ]]; then
    log_error "Issues found — see above. Run 'dotfiles install' to fix."
    _doctor_status=1
elif [[ $_dr_warn -gt 0 ]]; then
    log_warning "Healthy, with warnings above."
    _doctor_status=0
else
    log_success "Everything looks healthy!"
    _doctor_status=0
fi

unset -f check_section check_pass check_warn check_fail
return $_doctor_status
