#!/usr/bin/env zsh

# --- Decide on what parts to install
local choice
choice=$(gum choose --no-limit --selected="*" --header "What modules do you wish to install?" Homebrew Git DNS "Hosts file" Symlinks "Login shell" "macOS defaults" "Personal folders")

# --- 1. Install brews
if echo "$choice" | grep -q "Homebrew"; then
    echo "- 📦 Installing brew bundle"
    brew bundle --file $ROOT_DIR/Brewfile
fi

# --- 2. Git
if echo "$choice" | grep -q "Git"; then
    echo "- 🧑🏻‍💻 Preparing git"
    run partials/git
fi

# --- 3. DNS
if echo "$choice" | grep -q "DNS"; then
    echo "- 🛜 Configuring DNS"
    run partials/dns
fi

# --- 4. Symlinks
if echo "$choice" | grep -q "Symlinks"; then
    echo "- 🔗 Symlinks"
    run partials/symlinks
fi

# --- 5. Hosts blocklist (hblock)
if echo "$choice" | grep -q "Hosts file"; then
    echo "- 🛡️  Applying hosts blocklist (hblock)"
    if command -v hblock >/dev/null; then
        sudo hblock -q || log_warning "hblock run failed"
        sudo killall -HUP mDNSResponder 2>/dev/null || true
    else
        log_warning "hblock not installed — run the Homebrew module first"
    fi
fi

# --- 6. Login shell
if echo "$choice" | grep -q "Login shell"; then
    echo "- 🐚 Login shell"
    run partials/login-shell
fi

# --- 7. macOS defaults
if echo "$choice" | grep -q "macOS defaults"; then
    echo "- 💻 macOS defaults"
    run partials/macOS-defaults
fi

# --- 8. Personal folders
if echo "$choice" | grep -q "Personal folders"; then
    echo "- 📁 Personal folders"
    mkdir -p "$HOME/Desktop/Temp"
    mkdir -p "$HOME/Desktop/Screenshots"
fi