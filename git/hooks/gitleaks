#!/usr/bin/env zsh
set -euo pipefail

# GUI git clients often run hooks without Homebrew in PATH
gitleaks_bin=${commands[gitleaks]:-}
if [[ -z $gitleaks_bin && -x /opt/homebrew/bin/gitleaks ]]; then
    gitleaks_bin=/opt/homebrew/bin/gitleaks
fi

if [[ -z $gitleaks_bin ]]; then
    print -u2 "gitleaks not installed — skipping secret scan (brew install gitleaks)"
    exit 0
fi

args=(git --staged --redact --no-banner --log-level warn)

# --config would override a repo's own .gitleaks.toml, so only pass ours when it has none
repo_root=$(git rev-parse --show-toplevel)
if [[ ! -f $repo_root/.gitleaks.toml ]]; then
    args+=(--config "${0:A:h}/gitleaks.toml")
fi

exec "$gitleaks_bin" "${args[@]}"
